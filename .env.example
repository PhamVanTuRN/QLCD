# Configuration reference. Pass values to the backend process through the environment or secret provider.
# Development only. The database is recreated on restart.
ASPNETCORE_ENVIRONMENT=Development
Data__UseInMemory=true
Bootstrap__OnDevelopmentStart=false
Bootstrap__Username=
Bootstrap__ActivationCode=

# Relational environments require encrypted SQL with a validated server certificate.
ConnectionStrings__DefaultConnection=
ConnectionStrings__Migration=
Storage__Root=
Storage__LegacyRoot=
Storage__MalwareScannerHost=
Storage__MalwareScannerPort=3310
Storage__PendingRetentionDays=7
Security__DataProtectionKeyPath=
Security__CredentialResetAccountId=
Security__DataProtectionCertificatePath=
Security__DataProtectionCertificatePassword=
Security__TrustedProxies__0=
Security__CertificateOrigins__0=
MediatR__LicenseKey=
